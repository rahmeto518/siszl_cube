    bsk_plan_task_count_v,
    toDecimal64(ifNull(round(bsk_plan_task_count_v * 100.0 / nullIf(bsk_tasks_count_v, 0), 2), 0), 2) AS bsk_plan_task_percent_v,
    bsk_failed_task_count_v,
    toDecimal64(ifNull(round(bsk_failed_task_count_v * 100.0 / nullIf(bsk_tasks_count_v, 0), 2), 0), 2) AS bsk_failed_task_percent_v,
    zno_done_task_count_v,
    toDecimal64(ifNull(round(zno_done_task_count_v * 100.0 / nullIf(zno_tasks_count_v, 0), 2), 0), 2) AS zno_done_task_percent_v,
    zno_assumpt_task_count_v,
    toDecimal64(ifNull(round(zno_assumpt_task_count_v * 100.0 / nullIf(zno_tasks_count_v, 0), 2), 0), 2) AS zno_assumpt_task_percent_v,
    zno_plan_task_count_v,
    toDecimal64(ifNull(round(zno_plan_task_count_v * 100.0 / nullIf(zno_tasks_count_v, 0), 2), 0), 2) AS zno_plan_task_percent_v,
    zno_failed_task_count_v,
    toDecimal64(ifNull(round(zno_failed_task_count_v * 100.0 / nullIf(zno_tasks_count_v, 0), 2), 0), 2) AS zno_failed_task_percent_v,
    endo_tasks_count_v,
    endo_done_task_count_v,
    toDecimal64(ifNull(round(endo_done_task_count_v * 100.0 / nullIf(endo_tasks_count_v, 0), 2), 0), 2) AS endo_done_task_percent_v,
    endo_assumpt_task_count_v,
    toDecimal64(ifNull(round(endo_assumpt_task_count_v * 100.0 / nullIf(endo_tasks_count_v, 0), 2), 0), 2) AS endo_assumpt_task_percent_v,
    endo_plan_task_count_v,
    toDecimal64(ifNull(round(endo_plan_task_count_v * 100.0 / nullIf(endo_tasks_count_v, 0), 2), 0), 2) AS endo_plan_task_percent_v,
    endo_failed_task_count_v,
    toDecimal64(ifNull(round(endo_failed_task_count_v * 100.0 / nullIf(endo_tasks_count_v, 0), 2), 0), 2) AS endo_failed_task_percent_v,
    now64(3, 'Europe/Moscow') AS insert_dttm,
    now64(3, 'Europe/Moscow') AS update_dttm
FROM
(
    SELECT
        f_region_smo_cd,
        f_profile_cd,
        f_dn_group_cd,
        f_y,
        f_q,
        f_smo,
        f_mo,
        sumIf(task_cnt, profile_cd = 29) AS bsk_tasks_count_v,
        sumIf(task_cnt, profile_cd = 60) AS zno_tasks_count_v,
        sumIf(task_cnt, profile_cd = 29 AND task_status_cd = 1) AS bsk_done_task_count_v,
        sumIf(task_cnt, profile_cd = 29 AND task_status_cd = 2) AS bsk_assumpt_task_count_v,
        sumIf(task_cnt, profile_cd = 29 AND task_status_cd = 4) AS bsk_plan_task_count_v,
        sumIf(task_cnt, profile_cd = 29 AND task_status_cd = 3) AS bsk_failed_task_count_v,
        sumIf(task_cnt, profile_cd = 60 AND task_status_cd = 1) AS zno_done_task_count_v,
        sumIf(task_cnt, profile_cd = 60 AND task_status_cd = 2) AS zno_assumpt_task_count_v,
        sumIf(task_cnt, profile_cd = 60 AND task_status_cd = 4) AS zno_plan_task_count_v,
        sumIf(task_cnt, profile_cd = 60 AND task_status_cd = 3) AS zno_failed_task_count_v,
        sumIf(task_cnt, profile_cd = 122) AS endo_tasks_count_v,
        sumIf(task_cnt, profile_cd = 122 AND task_status_cd = 1) AS endo_done_task_count_v,
        sumIf(task_cnt, profile_cd = 122 AND task_status_cd = 2) AS endo_assumpt_task_count_v,
        sumIf(task_cnt, profile_cd = 122 AND task_status_cd = 4) AS endo_plan_task_count_v,
        sumIf(task_cnt, profile_cd = 122 AND task_status_cd = 3) AS endo_failed_task_count_v
    FROM tmp.profile_task_agg
    GROUP BY
        f_region_smo_cd,
        f_profile_cd,
        f_dn_group_cd,
        f_y,
        f_q,
        f_smo,
        f_mo
);
