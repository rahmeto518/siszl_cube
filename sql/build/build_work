6.4 tmp.work_person_base
INSERT INTO tmp.work_person_base
SELECT DISTINCT
tupleElement(period_tuple, 1) AS f_y,
tupleElement(period_tuple, 2) AS f_q,
real_region_smo_cd,
real_profile_cd,
real_dn_group_cd,
real_smo,
real_mo,
mpioip,
if(
(pol_cd = 1 AND age_on_period_end < 65)
OR
(pol_cd = 2 AND age_on_period_end < 60),
1,
0
) AS is_worker,
if(
(pol_cd = 1 AND age_on_period_end >= 65)
OR
(pol_cd = 2 AND age_on_period_end >= 60),
1,
0
) AS is_notwork
FROM
(
SELECT
s.*,
period_tuple,
greatest(
0,
dateDiff('year', birth_dt, tupleElement(period_tuple, 3))
- if(
formatDateTime(tupleElement(period_tuple, 3), '%m%d')
< formatDateTime(birth_dt, '%m%d'),
1,
0
)
) AS age_on_period_end
FROM tmp.work_person_filter_source AS s
ARRAY JOIN arrayFilter(
p -> tupleElement(p, 3) >= s.in_dt,
arrayConcat(
arrayMap(
y -> tuple(
toInt32(y),
toInt32(0),
toDate(concat(toString(y), '-12-31'))
),
range(2019, 2028)
),
arrayMap(
n -> tuple(
toInt32(toYear(addMonths(toDate('2019-01-01'), n * 3))),
toInt32(toQuarter(addMonths(toDate('2019-01-01'), n * 3))),
addDays(addMonths(toDate('2019-01-01'), n * 3 + 3), -1)
),
range(36)
)
)
) AS period_tuple
);
6.5 TRUNCATE TABLE cube.work;
INSERT INTO cube.work
(
    f_region_smo_cd,
    f_profile_cd,
    f_dn_group_cd,
    f_y,
    f_q,
    f_smo,
    f_mo,
    worker_count_v,
    worker_percent_v,
    notwork_count_v,
    notwork_percent_v,
    zl_on_dn_total,
    insert_dttm,
    update_dttm
)
SELECT
    a.f_region_smo_cd,
    a.f_profile_cd,
    a.f_dn_group_cd,
    a.f_y,
    a.f_q,
    a.f_smo,
    a.f_mo,
    a.worker_count_v,
    toDecimal64(ifNull(round(a.worker_count_v * 100.0 / nullIf(a.zl_on_dn_total, 0), 2), 0), 2) AS worker_percent_v,
    a.notwork_count_v,
    toDecimal64(ifNull(round(a.notwork_count_v * 100.0 / nullIf(a.zl_on_dn_total, 0), 2), 0), 2) AS notwork_percent_v,
    a.zl_on_dn_total,
    now64(3, 'Europe/Moscow') AS insert_dttm,
    now64(3, 'Europe/Moscow') AS update_dttm
FROM tmp.work_cube_agg AS a
LEFT JOIN cube.work AS w
    ON  a.f_region_smo_cd = w.f_region_smo_cd
    AND a.f_profile_cd = w.f_profile_cd
    AND a.f_dn_group_cd = w.f_dn_group_cd
    AND a.f_y = w.f_y
    AND a.f_q = w.f_q
    AND a.f_smo = w.f_smo
    AND a.f_mo = w.f_mo
WHERE w.f_region_smo_cd IS NULL;
SELECT *
FROM tmp.work_cube_agg
WHERE
    f_region_smo_cd = '0'
 OR f_profile_cd = '0'
 OR f_dn_group_cd = '0'
 OR f_smo = '0'
 OR f_mo = '0'
LIMIT 10;
