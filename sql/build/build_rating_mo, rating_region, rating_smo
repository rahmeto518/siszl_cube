    f_profile_cd,
    f_dn_group_cd,
    f_smo,
    f_mo,
    region_smo_cd,
    smo_cd,
    mo_cd,
    sum(insured_cnt) AS insured_cnt,
    sum(sl_dn_cnt) AS sl_dn_cnt,
    sum(all_tasks) AS all_tasks,
