    charge_item_cnt_sum,
    now64(3, 'Europe/Moscow'),
    now64(3, 'Europe/Moscow')
FROM
(
    SELECT
        f_y,
        f_q,
        f_region_smo_cd,
        f_profile_cd,
        f_dn_group_cd,
        f_smo,
        f_mo,
        region_smo_cd,
        uniqExact(mo_cd) AS mo_cnt,
        uniqExact(smo_cd) AS smo_cnt,
        sum(insured_cnt) AS insured_cnt_sum,
        sum(sl_dn_cnt) AS sl_dn_cnt_sum,
        sum(all_tasks) AS all_tasks_sum,
        sum(task_done_cnt) AS task_done_cnt_sum,
        sum(charge_item_cnt) AS charge_item_cnt_sum
    FROM precalc.rating_detail
    GROUP BY
        f_y,
        f_q,
        f_region_smo_cd,
        f_profile_cd,
        f_dn_group_cd,
        f_smo,
        f_mo,
        region_smo_cd
