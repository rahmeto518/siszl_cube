    charge_item_cnt,
    insert_dttm,
    update_dttm
)
SELECT
    f_y,
    f_q,
    f_region_smo_cd,
    f_profile_cd,
    f_dn_group_cd,
    f_smo,
    f_mo,
    region_smo_cd,
    mo_cnt,
    smo_cnt,
    insured_cnt_sum,
    sl_dn_cnt_sum,
    all_tasks_sum,
    task_done_cnt_sum,
    toDecimal64(
        ifNull(round(task_done_cnt_sum * 100.0 / nullIf(all_tasks_sum, 0), 2), 0),
        2
