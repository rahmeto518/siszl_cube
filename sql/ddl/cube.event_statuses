CREATE TABLE cube.event_statuses
(
    `f_region_smo_cd` String,
    `f_profile_cd` String,
    `f_dn_group_cd` String,
    `f_y` Int32,
    `f_q` Int32,
    `f_smo` String,
    `f_mo` String,
    `done_task_countV` UInt64,
    `done_task_percentV` Decimal(18,
 2),
    `assumpt_task_countV` UInt64,
    `assumpt_task_percentV` Decimal(18,
 2),
    `plan_task_countV` UInt64,
    `plan_task_percentV` Decimal(18,
 2),
    `failed_task_countV` UInt64,
    `failed_task_percentV` Decimal(18,
 2),
    `all_tasks` UInt64,
    `insert_dttm` DateTime64(3,
 'Europe/Moscow'),
    `update_dttm` DateTime64(3,
 'Europe/Moscow')
)
ENGINE = MergeTree
ORDER BY (f_region_smo_cd,
 f_profile_cd,
 f_dn_group_cd,
 f_y,
 f_q,
 f_smo,
 f_mo)
SETTINGS index_granularity = 8192;
