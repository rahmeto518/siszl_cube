CREATE TABLE tmp.dnp_eligible
(
    master_person_id String,
    f_region_smo_cd String,
    f_profile_cd String,
    f_dn_group_cd String,
    f_y Int32,
    f_q Int32,
    f_smo String,
    f_mo String,
    is_eligible UInt8
)
ENGINE = MergeTree
ORDER BY (master_person_id);

INSERT INTO tmp.dnp_eligible
SELECT
    dnp.master_person_id,
    if(ifNull(dnp.smo_cd, '') = '', '0', substring(dnp.smo_cd, 1, 2)) AS f_region_smo_cd,
    if(ifNull(dnp.profile_cd, 0) = 0, '0', toString(dnp.profile_cd)) AS f_profile_cd,
    if(ifNull(dnp.group_cd, 0) = 0, '0', toString(dnp.group_cd)) AS f_dn_group_cd,
    toYear(dnp.in_date_plan) AS f_y,
    0 AS f_q,
    if(ifNull(dnp.smo_cd, '') = '', '0', dnp.smo_cd) AS f_smo,
    if(ifNull(dnp.trigger_mo_cd, '') = '', '0', dnp.trigger_mo_cd) AS f_mo,
    1 AS is_eligible
FROM siszl_dashboard_person_dnp dnp
WHERE dnp.dnp IS NOT NULL
  AND (dnp.death_dt IS NULL OR dnp.death_dt >= :end_date);
