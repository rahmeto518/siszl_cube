CREATE TABLE IF NOT EXISTS cube.profiles
(
    f_region_smo_cd String,
    f_dn_group_cd String,
    f_y Int32,
    f_q Int32,
    f_smo String,
    f_mo String,
    bsk_tasks_count UInt64,
    bsk_done_task_count UInt64,
    bsk_assumpt_task_count UInt64,
    bsk_plan_task_count UInt64,
    bsk_failed_task_count UInt64,
    zno_tasks_count UInt64,
    zno_done_task_count UInt64,
    zno_assumpt_task_count UInt64,
    zno_plan_task_count UInt64,
    zno_failed_task_count UInt64,
    endo_tasks_count UInt64,
    endo_done_task_count UInt64,
    endo_assumpt_task_count UInt64,
    endo_plan_task_count UInt64,
    endo_failed_task_count UInt64
)
ENGINE = MergeTree
ORDER BY (f_region_smo_cd, f_dn_group_cd, f_y, f_q, f_smo, f_mo);


