6.4 tmp.work_person_base
INSERT INTO tmp.work_person_base
SELECT DISTINCT
tupleElement(period_tuple, 1) AS f_y,
tupleElement(period_tuple, 2) AS f_q,
real_region_smo_cd,
real_profile_cd,
real_dn_group_cd,
real_smo,
real_mo,
mpioip,
if(
(pol_cd = 1 AND age_on_period_end < 65)
OR
(pol_cd = 2 AND age_on_period_end < 60),
1,
0
) AS is_worker,
if(
(pol_cd = 1 AND age_on_period_end >= 65)
OR
(pol_cd = 2 AND age_on_period_end >= 60),
1,
0
) AS is_notwork
FROM
(
SELECT
s.*,
period_tuple,
greatest(
0,
dateDiff('year', birth_dt, tupleElement(period_tuple, 3))
- if(
formatDateTime(tupleElement(period_tuple, 3), '%m%d')
< formatDateTime(birth_dt, '%m%d'),
1,
0
)
) AS age_on_period_end
FROM tmp.work_person_filter_source AS s
ARRAY JOIN arrayFilter(
p -> tupleElement(p, 3) >= s.in_dt,
arrayConcat(
arrayMap(
y -> tuple(
toInt32(y),
toInt32(0),
toDate(concat(toString(y), '-12-31'))
),
range(2019, 2028)
),
arrayMap(
n -> tuple(
toInt32(toYear(addMonths(toDate('2019-01-01'), n * 3))),
toInt32(toQuarter(addMonths(toDate('2019-01-01'), n * 3))),
addDays(addMonths(toDate('2019-01-01'), n * 3 + 3), -1)
),
range(36)
)
)
) AS period_tuple
);
