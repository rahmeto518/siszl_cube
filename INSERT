    CROSS JOIN
    (
        SELECT arrayJoin(['p', 'c']) AS metric_kind
    ) AS k
    CROSS JOIN
    (
        SELECT arrayJoin(range(32)) AS mask
    ) AS m
    WHERE if(metric_kind = 'p', closed_y + 1, closed_y) BETWEEN 2019 AND 2027
